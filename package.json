{
  "name": "lore",
  "version": "0.1.0",
  "private": true,
  "description": "The wiki for all your agents. A local-first markdown wiki manager that every AI agent can read.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4646",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4646",
    "lint": "eslint",
    "mcp": "node mcp/server.mjs",
    "electron": "electron electron/main.js",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "site:build": "LORE_MODE=site next build",
    "site:start": "LORE_MODE=site next start"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@uiw/react-codemirror": "4.25.11",
    "@xenova/transformers": "2.17.2",
    "chokidar": "5.0.0",
    "clsx": "^2.1.1",
    "d3-force": "3.0.0",
    "diff": "9.0.0",
    "framer-motion": "12.42.2",
    "gpt-tokenizer": "3.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "marked": "18.0.7",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "3.0.10",
    "@types/diff": "7.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "electron/main.js",
  "overrides": {
    "sharp": "^0.34.5"
  }
}
